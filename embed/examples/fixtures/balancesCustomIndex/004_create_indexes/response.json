{
  "data": {
    "schema": {
      "account": {
        "name": "account",
        "range": [],
        "partition": [
          {
            "alias": "account_id",
            "value": "document.account_id"
          }
        ],
        "on": "Balance",
        "constraints": {"isStandardBalance":"document.calculation_id == uuid('00000000-0000-0000-0000-000000000000')"},
        "unique": false,
        "historical": false
      },
      "account_journal": {
        "name": "account_journal",
        "range": [],
        "partition": [
          {
            "alias": "account_id",
            "value": "document.account_id"
          },
          {
            "alias": "journal_id",
            "value": "document.journal_id"
          }
        ],
        "on": "Balance",
        "constraints": {"isStandardBalance":"document.calculation_id == uuid('00000000-0000-0000-0000-000000000000')"},
        "unique": false,
        "historical": false
      },
      "dr_balance": {
        "name": "dr_balance",
        "range": [
          {
            "alias": "dr_balance",
            "value": "document.settled.dr_balance.decimal()",
            "sort": "ASC"
          }
        ],
        "partition": [
          {
            "alias": "journal_id",
            "value": "document.journal_id"
          }
        ],
        "on": "Balance",
        "constraints": {"isStandardBalance":"document.calculation_id == uuid('00000000-0000-0000-0000-000000000000')"},
        "unique": false,
        "historical": false
      },
      "normal_balance": {
        "name": "normal_balance",
        "range": [
          {
            "alias": "normal_balance",
            "value": "(document.settled.cr_balance - document.settled.dr_balance).decimal()",
            "sort": "ASC"
          }
        ],
        "partition": [
          {
            "alias": "journal_id",
            "value": "document.journal_id"
          }
        ],
        "on": "Balance",
        "constraints": {"isStandardBalance":"document.calculation_id == uuid('00000000-0000-0000-0000-000000000000')"},
        "unique": false,
        "historical": false
      },
      "normal_balance_historical": {
        "name": "normal_balance_historical",
        "range": [
          {
            "alias": "normal_balance",
            "value": "decimal(document.settled.cr_balance - document.settled.dr_balance)",
            "sort": "ASC"
          }
        ],
        "partition": [
          {
            "alias": "journal_id",
            "value": "document.journal_id"
          },
          {
            "alias": "account_id",
            "value": "document.account_id"
          }
        ],
        "on": "Balance",
        "constraints": {"isStandardBalance":"document.calculation_id == uuid('00000000-0000-0000-0000-000000000000')"},
        "unique": false,
        "historical": true
      }
    }
  }
}
